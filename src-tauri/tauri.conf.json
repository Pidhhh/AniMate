{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AniMate",
  "version": "0.1.0",
  "identifier": "app.animate.companion",
  "build": {
    "beforeDevCommand": "npm run vite",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../dist": "dist",
      "../public/assets": "assets"
    },
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    }
  }
}
