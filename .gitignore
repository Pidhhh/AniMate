# Character assets.
#
# The Spine skeletons, scene plates and voice clips are extracted game data
# and are not redistributable — see the licensing section of MIGRATION-PLAN.md.
# They live on disk for local development only and must never be committed or
# shipped in a public installer.
public/assets/*
!public/assets/README.md
!public/assets/.gitkeep

# Local model fixtures for development.
#
# Example models kept on disk to test the importer and the renderers against.
# They are someone else's character art — a PMX model carries its own licence
# from its author, and none of them are ours to redistribute. The app itself
# ships with no models at all (see public/assets/README.md); these are only
# here so `npm run dev` has something to load.
#
# Nothing under here should ever be committed, and nothing under here is read
# at runtime — the app reads from the app data directory, not the repo.
models/

# Scratch space for generated images.
generated-images/
